# ==============================================================================
# AutoMisho — Root .gitignore
# Prevents accidental commits of secrets, dependencies, builds, and local caches
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/install-state.gz

# Python Virtual Environments & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/

lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
coverage/
.nyc_output/
.pytest_cache/
.coverage
htmlcov/

# Next.js & Frontend Build Artifacts
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Sensitive Credentials (CRITICAL)
.env
.env.local
.env.*.local
*.env
*.pem
*.pfx
*.p12
*.key
*.cert
*.crt

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
*.db-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Cache
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local Indexing & Agent Metadata

.codegraph/


# Project persistence & Context
docs/
contexto.md