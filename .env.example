# ==========================================
# AutoMisho v2 Environment Variables
# ==========================================

# Command Code Provider API (OpenAI-compatible)
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_API_KEY=your_command_code_api_key_here
DEFAULT_AGENT_MODEL=meta/muse-spark-1.3

# Sentinel Two-Phase Commit Security
SENTINEL_SECRET=super_secret_hmac_key_for_automisho_sentinel

# PostgreSQL + pgvector
POSTGRES_USER=automisho
POSTGRES_PASSWORD=automisho_secret
POSTGRES_DB=automisho
DATABASE_URL=postgresql://automisho:automisho_secret@localhost:5432/automisho

# Redis
REDIS_URL=redis://localhost:6379/0

# Browser Worker Service
BROWSER_SERVICE_URL=http://localhost:3001

# NextAuth / Frontend
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
